# Convex (from `bunx convex dev`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk (from https://dashboard.clerk.com) — required, (app)/layout.tsx calls auth.protect()
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Simulador — API HTTPS del generator (simulator-car/simulator/generator), usada por
# (app)/simulador para start/stop/inject-fault directo desde la consola
NEXT_PUBLIC_SIMULATOR_API_URL=

# Cursor SDK (scripts/cursor-agent.ts) — never commit real values
CURSOR_API_KEY=
